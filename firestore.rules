rules_version = '2';
// Part 1 baseline. All clinical writes go through Cloud Functions (Admin SDK,
// which bypasses these rules), so client access is read-mostly and role-gated.
// Hardened rules + field-level checks are finalised in Part 2.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }

    // Clinical content (rule_pack / drug_master): readable by clinical roles.
    match /content/{doc} {
      allow read: if isSignedIn() && role() in ['physician', 'pharmacist', 'admin', 'researcher'];
      allow write: if false; // server-only
    }

    // Assessments: never written from the client; reads are server-mediated.
    match /assessments/{id} {
      allow read, write: if false; // server-only (Admin SDK)
    }

    // Audit log is append-only and server-only; readable by admin for review.
    match /audit_log/{id} {
      allow read: if isSignedIn() && role() == 'admin';
      allow write: if false; // server-only
    }
  }
}
