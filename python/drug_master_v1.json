{
  "schema_version": "1.0.0",
  "last_updated": "2026-06-03",
  "description": "METACOD GLP-1 Complication Prevention — molecular drug profiles starter database. Each profile encodes PK absorption/metabolism/elimination flags consumed by rule_pack_v1.json. Extensible drug-by-drug for production.",
  "field_definitions": {
    "requires_acidic_pH": "Sensitivity of dissolution to elevated gastric pH (PPI/H2RA). Enum: none|low|moderate|high",
    "cation_binding_sensitive": "Forms non-absorbable chelates with Ca/Fe/Mg/Al/sucralfate",
    "proximal_absorption_critical": "Absorption window confined to proximal small bowel",
    "bile_dependent": "Requires bile acids for micellar solubilization (lipophilic)",
    "food_effect": "Enum: none|with_food|fasting|specific",
    "high_first_pass": "Significant first-pass hepatic extraction; cirrhosis can raise bioavailability",
    "hepatic_extraction": "Enum: low|moderate|high",
    "inflammation_sensitive_clearance": "CYP substrate clearance can fall during systemic inflammation (IL-6/cytokine CYP suppression)",
    "renal_clearance_fraction": "Enum: low|moderate|high|variable",
    "active_metabolites_renally_cleared": "Active metabolites accumulate in CKD",
    "protein_binding": "Enum: low|moderate|high. High binding + low albumin = misleading total levels",
    "narrow_therapeutic_index": "Small PK shifts produce clinical events",
    "tmax_sensitive": "Clinical effect depends on rapid peak (delayed gastric emptying matters)",
    "modified_release": "ER/MR/enteric — vulnerable after altered GI anatomy",
    "post_bariatric_variability": "Enum: low|moderate|high",
    "gut_edema_sensitive": "Oral bioavailability falls in HF congestion / gut edema",
    "oral_contraceptive": "Subject to label warnings on tirzepatide first 4 weeks",
    "evidence_grade": "A=regulatory/RCT, B=observational+mechanistic, C=mechanistic only"
  },
